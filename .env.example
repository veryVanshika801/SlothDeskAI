# SlothDesk AI - Production Environment Variables
# AI Studio automatically injects GEMINI_API_KEY from user secrets.
# On Vercel, configure these in Project Settings > Environment Variables.

# 1. Google Gemini Provider (Primary)
# Required for live Gemini 3.8 Flash inference.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Open-Weight Model Provider (Optional Alternative)
# Configure if using genuine open-weight models (e.g., Gemma 2 9B via Groq, OpenRouter, or Hugging Face)
OPENWEIGHT_API_KEY=""
OPENWEIGHT_BASE_URL="https://api.groq.com/openai/v1"
OPENWEIGHT_MODEL="google/gemma-2-9b-it"

# 3. Provider Override (Optional: "gemini" | "openweight" | "demo")
# If left empty, auto-detects based on available API keys.
AI_PROVIDER=""

# 4. App URL
APP_URL="http://localhost:3000"
